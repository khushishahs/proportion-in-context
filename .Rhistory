knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(readxl)
library(dplyr)
stimuli_set <- read.csv("stimuli_set.csv") |>
mutate(trial_index = 1:n()) |>
select(trial_index, everything())
stimuli_set
stimuli_set1 <- stimuli_set %>%
mutate(
# compute proportions in decimal form
corr_prop   = correct_num / correct_den,
incorr_prop = incorr_num  / incorr_den,
# compute ratio between proportions in decimal form
ratio_btw_prop = corr_prop / incorr_prop,
# whether or not the comparison crosses the half boundary
cross_half = case_when(corr_prop <= .5 & incorr_prop >= .5 ~ "cross", # this isn't actually possible, because corr > incorr
corr_prop >= .5 & incorr_prop <= .5 ~ "cross",
corr_prop > .5 & incorr_prop > .5 ~ "both-above",
corr_prop < .5 & incorr_prop < .5 ~ "both-below"),
# compute ratio between numerators in decimal form; flip ratio if < 1
ratio_btw_num = if_else(
(correct_num / incorr_num) < 1,
incorr_num / correct_num,
correct_num / incorr_num
)
)
stimuli_set1
summary_stats <- stimuli_set1 %>%
# filter relevant columns
select(
correct_num, correct_den,
incorr_num, incorr_den,
corr_prop, incorr_prop,
ratio_btw_prop, ratio_btw_num
) %>%
# convert to long form
pivot_longer(
cols = everything(),
names_to = "variable",
values_to = "value"
) %>%
# compute min, max, mean for each variable
summarise(
min  = min(value),
max  = max(value),
mean = mean(value),
.by = variable
)
summary_stats
congruency_stats <- stimuli_set1 %>%
# filter relevant columns
mutate(cross_half_numeric = case_when(cross_half == "cross" ~ 1,
cross_half %in% c("both-below", "both-above") ~ 0)) |>
select(
Congruency,
corr_prop,
incorr_prop,
ratio_btw_num,
ratio_btw_prop,
cross_half_numeric
) %>%
# convert to long form
pivot_longer(
cols = c(corr_prop, incorr_prop, ratio_btw_num, ratio_btw_prop, cross_half_numeric),
names_to = "variable",
values_to = "value"
) %>%
# compute min, max, mean by congruency for each variable
summarise(
min  = min(value),
max  = max(value),
mean = mean(value),
.by = c(Congruency, variable)
) %>%
# order columns
arrange(Congruency, variable)
congruency_stats
